# =============================================================================
# DAN FastAPI Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Required variables are marked with (REQUIRED)
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Debugging
# -----------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=development

# Enable debug mode (verbose logging, detailed errors)
DEBUG=true

# -----------------------------------------------------------------------------
# Database (REQUIRED)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# For Supabase: Get from Project Settings > Database > Connection String
DATABASE_URL=postgresql://postgres:your-password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Redis (REQUIRED for background jobs)
# -----------------------------------------------------------------------------
# Used for: Celery task queue, rate limiting, caching
# Format: redis://[:password]@host:port/db
# For local development: redis://localhost:6379/0
# For Render/production: Use your Redis instance URL
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Firebase Authentication (REQUIRED)
# -----------------------------------------------------------------------------
# Firebase project ID (from Firebase Console > Project Settings)
FIREBASE_PROJECT_ID=your-project-id

# Path to Firebase service account JSON file
# Download from: Firebase Console > Project Settings > Service Accounts
# Leave empty to use GOOGLE_APPLICATION_CREDENTIALS env var
FIREBASE_CREDENTIALS_PATH=./service-account.json

# -----------------------------------------------------------------------------
# OpenAI API (REQUIRED for AI features)
# -----------------------------------------------------------------------------
# API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model to use for AI features
# Options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
# gpt-4o-mini recommended for cost-effective summaries
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# General API rate limit (requests per minute per user)
RATE_LIMIT_GENERAL=100

# AI endpoint rate limit (requests per hour per user)
# Lower to control OpenAI costs
RATE_LIMIT_AI=20

# -----------------------------------------------------------------------------
# Machine Learning
# -----------------------------------------------------------------------------
# Path to ML model files (DistilBERT + XGBoost)
# Relative to backend_fastapi/ directory
ML_MODELS_PATH=./ml_models

# Number of threads for ML inference
# Increase for better throughput on multi-core systems
ML_THREAD_POOL_SIZE=4

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Host to bind to (0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Port to listen on
PORT=8000

# =============================================================================
# Optional: Docker/Production Overrides
# =============================================================================
# These are typically set in docker-compose.yml or deployment platform

# CELERY_BROKER_URL=${REDIS_URL}
# CELERY_RESULT_BACKEND=${REDIS_URL}

# =============================================================================
# Notes
# =============================================================================
# - Never commit your .env file to version control
# - Use different values for development/staging/production
# - For Render deployment, set these in the Environment tab
# - ML models must be present at ML_MODELS_PATH for inference to work
#   Run `python training/productivityClassifier.py` to generate them
